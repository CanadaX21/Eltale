# Your ROM and everything the build makes from it: never commit these.
*.z64
*.n64
*.v64
baserom*
# asm/ is what splat writes from your ROM, except the hand-kept boot entry, asm/entry.s, which is part of the source:
# without it splat writes the original entry back, whose .bss clear has the ROM's fixed size (a modified build whose
# .bss grows would then not clear all of it)
asm/*
!asm/entry.s
assets/
build/
expected/
*.ok

# Written by ./configure (splat and configure.py)
build.ninja
.ninja_log
.ninja_deps
objdiff.ninja
objdiff.json
eltail.ld
undefined_funcs_auto.txt
undefined_syms_auto.txt
.splache

# Downloaded by tools/setup.sh: proprietary, not part of this repository
tools/ido_5.3/

# Python
.venv/
__pycache__/
*.pyc

# Context files made for decompilation tools
ctx.c
