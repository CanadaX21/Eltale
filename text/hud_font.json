{
 "about": "The HUD font's text encoding: what each byte of a HUD string does, and which character each cell of the HUD font sheet draws. The monsters', bosses' and spells' names and the placeholder for a spell not yet learned are HUD strings, drawn by DrawHUDText (the battle's monster card, the spell banner and the spell cross); the dialogue, signs and menus use the other encoding, text/encoding.json. Read from the matched C (DrawHUDText, GetHUDTextWidth) and the original ROM's sheet, cell by cell. tools/text_codec.py (HudEncoding) reads it.",
 "font": {
  "symbol": "gHudFontImage",
  "type": "HudImage",
  "loaded with": "the cutscene bank (InitGraphics), resident from boot",
  "drawn by": "DrawHUDText",
  "format": "CI4",
  "width": 144,
  "height": 45,
  "cell width": 8,
  "cell height": 9,
  "columns": 18,
  "rows": 5,
  "columns a byte reaches": 16,
  "palettes": "gHudFontPalettes, chosen by DrawHUDText's colour argument (the spell labels' by availability)"
 },
 "codes": [
  {
   "bytes": "0x00-0x7F",
   "kind": "glyph",
   "source text": "the glyph table's character, or {R,C} for a cell the table gives no character",
   "evidence": "DrawHUDText draws the cell in row (byte & 0x70) >> 4, column byte & 0x0F, and moves the pen 8 texels; GetHUDTextWidth counts 8"
  },
  {
   "bytes": "0x80",
   "kind": "voiced mark",
   "source text": "the voiced kana: the glyph before it with the mark (ガ is カ then 0x80)",
   "evidence": "DrawHUDText draws column 15 of the last glyph's row two texels left of the pen and one up, then moves the pen 1; GetHUDTextWidth counts 1"
  },
  {
   "bytes": "0x81",
   "kind": "semi-voiced mark",
   "source text": "the semi-voiced kana: the glyph before it with the mark (パ is ハ then 0x81)",
   "evidence": "as 0x80, from column 16 of the last glyph's row"
  },
  {
   "bytes": "0x82",
   "kind": "half space",
   "source text": "a space",
   "evidence": "DrawHUDText moves the pen 4 texels; GetHUDTextWidth counts 4"
  },
  {
   "bytes": "0xFF",
   "kind": "end",
   "source text": "implicit",
   "evidence": "DrawHUDText and GetHUDTextWidth stop at it"
  },
  {
   "bytes": "0x83-0xFE",
   "kind": "unused",
   "source text": "{code XX}",
   "evidence": "DrawHUDText would draw the cell of the byte with bit 0x80 cleared while GetHUDTextWidth counts 0; no string of the original uses them"
  }
 ],
 "marks": "Rows 0 to 2 hold the two voicing marks in columns 15 and 16, the same bitmap in each row. A mark after a glyph of row 3 or 4 would draw that row's column 15 or 16 instead (the digit 3, or nothing): the encoder refuses it, and the decoder writes such a byte as {code 80} or {code 81}.",
 "grades": {
  "verified": "the cell's bitmap read, and its character confirmed by use: the original's HUD strings that use the cell decode as words with it",
  "read": "the cell's bitmap read; no string of the original uses the cell",
  "mark": "a voicing mark: the 0x80 and 0x81 codes draw it over the glyph before them; no byte draws it as a glyph",
  "empty": "no texel set"
 },
 "counts": {
  "verified": 59,
  "mark": 6,
  "empty": 18,
  "read": 7
 },
 "sources": [
  {
   "name": "the original ROM",
   "about": "every cell read from its bitmap in the original Japanese ROM (rendered at 12x, and by palette index to tell the strokes from their shading); no outside table, tool or translation was used. The monsters', bosses' and spells' names in other localizations played no part."
  }
 ],
